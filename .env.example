DATABASE_URL=your_connection_string_here

# Durable document bytes. Neon stays DATABASE_URL. Do not put real keys here.
# Local: `supabase start`, then copy API URL and service_role from `supabase status`.
# Vercel: set these three on the project. Local uploads/ is not used in production.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=medical-files

# Non-production only, when the three Supabase values above are unset.
# UPLOAD_DIR=uploads
